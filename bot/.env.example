# Token from @BotFather (/newbot)
BOT_TOKEN=123456789:AA...your_token_here

# The short_name you set with @BotFather via /newgame
GAME_SHORT_NAME=ptn_pnh

# Public HTTPS URL to your deployed game/index.html (e.g. GitHub Pages)
GAME_URL=https://yourusername.github.io/ptn-pnh-game/index.html

# Any long random string - used to sign the score-report requests
SIGNING_SECRET=change-this-to-a-random-64-char-string

PORT=3000
